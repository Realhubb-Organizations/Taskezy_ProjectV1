# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres — connect as the least-privilege taskezy_app role, never as postgres superuser.
# See Taskezy_DB/DATA_DICTIONARY.md "Security" section for why this role exists.
DATABASE_URL=postgresql://taskezy_app:CHANGE_ME@localhost:5433/mydb

# Connection pool sizing — see README.md "Scaling" section for guidance.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# JWT — generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-netlify-site.netlify.app

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Meta (Facebook/Instagram) Lead Ads — from developers.facebook.com, App Dashboard > Settings > Basic
META_APP_ID=CHANGE_ME
META_APP_SECRET=CHANGE_ME
# Any random string you choose — Meta echoes it back during webhook verification, must match exactly.
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME
# Must exactly match the "Valid OAuth Redirect URI" configured in the Meta App Dashboard.
META_OAUTH_REDIRECT_URI=https://api.taskezy.in/api/v1/meta/callback
META_GRAPH_API_VERSION=v25.0
# 32 raw bytes, base64-encoded — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=CHANGE_ME
# Where the admin's browser lands after connecting/disconnecting a Meta Page
FRONTEND_URL=https://taskezy.in
