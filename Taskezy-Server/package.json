{
  "name": "taskezy-server",
  "version": "0.1.0",
  "private": true,
  "description": "TASKEZY API server — Node.js/TypeScript/Express, talks directly to the Postgres database in Taskezy_DB.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "guard:logs": "tsx scripts/check-log-redaction.ts",
    "build": "npm run guard:logs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "pgboss:migrate": "pg-boss migrate --schema pgboss"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.0",
    "pg": "^8.11.5",
    "pg-boss": "^12.38.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.9.3",
    "typescript": "^5.4.5"
  }
}
