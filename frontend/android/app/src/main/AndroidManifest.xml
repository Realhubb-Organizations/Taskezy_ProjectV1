<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- No READ_PHONE_STATE: this app used to watch real device call state
         via a native TelephonyManager plugin (CallStatePlugin), but Android
         kills this app's backgrounded process within seconds of placing a
         call (confirmed on-device, 2026-10-10), destroying that listener
         before it could ever fire — structurally unworkable without a
         foreground service. Dropped in favor of the same "ask when you
         return to the app" pattern already used for WhatsApp (see
         frontend/src/lib/callTrigger.ts), which needs no telephony
         permission at all.

         READ_CALL_LOG is kept: CallLogPlugin only does a one-shot query
         against the CallLog ContentProvider (no listener, nothing for
         Android to kill mid-operation), for the Call Log CRM feature. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
</manifest>
