# Monorepo root .gitignore — covers both frontend/ and Taskezy-Server/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/

# next.js (frontend/)
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# server build output (Taskezy-Server/)
Taskezy-Server/dist/

# production
build/

# env files — never commit real secrets
.env
.env.*
!.env.example
!*/.env.example

# misc
.DS_Store
*.pem

# Firebase service-account credentials — never commit, contains a private key
*firebase-adminsdk*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript
*.tsbuildinfo

# internal docs — kept locally only, not on GitHub. Every markdown file is
# ignored (subproject READMEs, generated schema docs, internal notes) except
# the root README.md, which is the only one that stays public.
*.md
!/README.md
/TASKEZY_Developer_Guide.pdf

# generated deliverables (Data Dictionary / DFD Word docs) — kept locally only
/docs/

# load/stress testing scripts + reports/tokens — local-only, never pushed.
# Being ignored (not just locally git-removed) also means git itself never
# touches this folder on pull/checkout/merge, so it can't be wiped by
# anyone else's pull either — only an explicit `git clean -x` would.
/load-testing/
