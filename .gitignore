# Monorepo root .gitignore — covers both frontend/ and Taskezy-Server/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage/

# next.js (frontend/)
frontend/.next/
frontend/out/
frontend/next-env.d.ts

# server build output (Taskezy-Server/)
Taskezy-Server/dist/

# production
build/

# env files — never commit real secrets
.env
.env.*
!.env.example
!*/.env.example

# misc
.DS_Store
*.pem

# Firebase service-account credentials — never commit, contains a private key
*firebase-adminsdk*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript
*.tsbuildinfo

# internal docs — kept locally only, not on GitHub (README.md is the only doc that stays public)
/credentials.md
/IMPLEMENTATIONS.md
/ARCHITECTURAL_BLUEPRINT.md
/SDLC_MANUAL.md
/Taskezy-Server/API_TESTING.md
